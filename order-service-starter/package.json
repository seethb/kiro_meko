{
  "name": "order-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Order service before the order-history feature: one row per order, status updated in place. The starting point for the Kiro + Meko demo.",
  "scripts": {
    "api": "node server/index.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "vite build",
    "test": "node --test test/",
    "verify:kiro": "npm --prefix ../console run verify:kiro --silent"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  }
}
