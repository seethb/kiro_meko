# Meko MCP endpoint and an API key for the same Meko account Kiro signs in with.
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=your-meko-api-key
# The datapack the agents write to. Created on first start if it doesn't exist.
# Use a fresh name for each recording so the demo starts with no prior context.
MEKO_DATAPACK_NAME=kiro-order-service
PORT=7840
